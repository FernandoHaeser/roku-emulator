sub Main()
    print "@@PROBE_BEGIN"
    r = CreateObject("roRegex", "(\d+)\s+(\w+)", "i")
    print "regex="; r.IsMatch("123 ABC")
    print FormatJSON(r.Match("123 ABC"))
    print r.ReplaceAll("12 ab 34 cd", "\2:\1")
    fs = CreateObject("roFileSystem")
    print "write="; WriteAsciiFile("tmp:/emu-test.txt", "abc")
    print "exists="; fs.Exists("tmp:/emu-test.txt")
    print "read="; ReadAsciiFile("tmp:/emu-test.txt")
    b = CreateObject("roByteArray")
    print "readbytes="; b.ReadFile("tmp:/emu-test.txt")
    print b.ToHexString()
    print "readonly="; WriteAsciiFile("pkg:/forbidden.txt", "x")
    print "delete="; fs.Delete("tmp:/emu-test.txt")
    b.FromAsciiString("abc")
    digest = CreateObject("roEVPDigest")
    print "digestsetup="; digest.Setup("sha256")
    print digest.Process(b)
    key = CreateObject("roByteArray")
    key.FromAsciiString("key")
    h = CreateObject("roHMAC")
    print "hmacsetup="; h.Setup("sha256", key)
    mac = h.Process(b)
    print mac.ToHexString()
    cipher = CreateObject("roEVPCipher")
    print "ciphersetup="; cipher.Setup(true, "aes-128-cbc", "2b7e151628aed2a6abf7158809cf4f3c", "000102030405060708090a0b0c0d0e0f", 0)
    b.FromHexString("6bc1bee22e409f96e93d7e117393172a")
    encrypted = cipher.Process(b)
    print encrypted.ToHexString()
    print "@@PROBE_END"
end sub
