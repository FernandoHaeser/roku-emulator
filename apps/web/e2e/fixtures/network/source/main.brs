sub Main()
    base = "HTTP_BASE_URL"
    x = CreateObject("roUrlTransfer")
    x.SetUrl(base + "/hello")
    print "sync="; x.GetToString()
    x.SetUrl(base + "/post")
    x.AddHeader("X-Test", "channel")
    print "post="; x.PostFromString("payload")
    port = CreateObject("roMessagePort")
    x.SetMessagePort(port)
    x.SetUrl(base + "/hello")
    print "async="; x.AsyncGetToString()
    msg = wait(2000, port)
    print "event="; type(msg)
    print "code="; msg.GetResponseCode()
    print "body="; msg.GetString()
    print "identity="; msg.GetSourceIdentity() = x.GetIdentity()
    x.SetUrl(base + "/hello")
    print "file="; x.GetToFile("tmp:/response.txt")
    print "stored="; ReadAsciiFile("tmp:/response.txt")
    x.EnableCookies()
    x.SetUrl(base + "/set-cookie")
    x.GetToString()
    x.SetUrl(base + "/cookie")
    print "cookie="; x.GetToString()
    x.SetUrl(base + "/digest")
    x.SetUserAndPassword("user", "test-password")
    print "digest="; x.GetToString()
    x.SetUrl(base + "/slow")
    print "start="; x.AsyncGetToString()
    print "busy="; x.AsyncGetToString()
    print "cancel="; x.AsyncCancel()
    msg = wait(20, port)
    print "cancelled="; msg = invalid
    print "@@NETWORK_DONE"
end sub
