# Real Roku device used as fidelity oracle (Developer Mode must be enabled).
# Copy to .env and fill in. .env is git-ignored: never commit credentials.

# Device IP on the local network, e.g. 192.168.0.42
ROKU_HOST=
# Developer Mode web installer user (always "rokudev" on retail devices)
ROKU_DEV_USER=rokudev
# Password chosen when enabling Developer Mode
ROKU_DEV_PASSWORD=
# Optional overrides
ROKU_ECP_PORT=8060
ROKU_CONSOLE_PORT=8085
# Max time (ms) to wait for a probe to print its end marker
ORACLE_PROBE_TIMEOUT_MS=20000
