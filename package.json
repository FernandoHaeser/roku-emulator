{
  "name": "roku-emulator",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm build:wasm && pnpm --filter @roku-emu/web dev",
    "build": "pnpm build:wasm && pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "oracle": "pnpm --filter @roku-emu/oracle cli",
    "build:wasm": "./scripts/build-wasm.sh",
    "test:rust": "./scripts/cargo.sh test --workspace",
    "conformance": "./scripts/cargo.sh run --release -q -p brs-cli -- conformance fidelity",
    "e2e": "pnpm build:wasm && pnpm --filter @roku-emu/web e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "license": "Apache-2.0"
}
